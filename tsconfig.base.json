{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@inbox/shared": ["packages/shared/src"],
      "@inbox/shared/*": ["packages/shared/src/*"],
      "@inbox/ui": ["packages/ui/src"]
    }
  }
}

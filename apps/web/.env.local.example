# Supabase (used for auth, the pair-device edge function, and a few minimal
# non-content tables). NOT used for email, tokens, BYOK keys, or task content
# — those all live on the device in IndexedDB / SQLite.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local-first OAuth client (web, PKCE). Only the client_id is public.
# The client_secret is unused by the browser flow — PKCE replaces it on the wire.
NEXT_PUBLIC_GOOGLE_OAUTH_CLIENT_ID=

# CipherStack vending token for runtime API keys (optional, only used by BYOK
# helper that fetches a fresh provider key on demand).
CIPHERSTACK_TOKEN=

# Mobile env. Copy this file to `.env` and fill in real values.

# Supabase (used for auth + pairing relay only — no user data).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Google OAuth — Android client, signature-bound to the APK. No client_secret.
# See docs/gcp-setup/ANDROID-OAUTH.md for how to obtain this.
GOOGLE_ANDROID_CLIENT_ID=

# (iOS support is planned; uncomment when wiring iOS OAuth.)
# GOOGLE_IOS_CLIENT_ID=
